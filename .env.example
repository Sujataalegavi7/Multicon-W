# Port to expose on the host (defaults to 80)
HTTP_PORT=80

# Frontend URL or Domain (e.g. http://yourdomain.com or https://yourdomain.com)
CLIENT_URL=http://localhost
VITE_API_URL=/api

# MongoDB Configuration
MONGO_INITDB_ROOT_USERNAME=crr_db_user
MONGO_INITDB_ROOT_PASSWORD=ChangeThisToStrongPassword123!
MONGO_INITDB_DATABASE=crr_db

# Security & JWT Secret
JWT_SECRET=super_secret_production_jwt_random_key_change_me_now
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (for seed script)
ADMIN_LOGIN_ID=crr_admin
ADMIN_CODE=Admin@CRR2026

# File Upload Limit (in MB)
MAX_UPLOAD_SIZE_MB=20
